---
import { Image } from "astro:assets";
import PhoneIcon from "@icons/phone.svg";
import ClockIcon from "@icons/clock.svg";
import PinIcon from "@icons/pin.svg";

import contactMain from "@assets/images/contact-main.jpg";
import contactLaptop from "@assets/images/contact-laptop.jpg";
import contactMeeting from "@assets/images/contact-meeting.jpg";
---

<section class="contact">
  <div class="contact-copy">
    <p class="eyebrow">PROCESS</p>
    <h2>Contact Us. It's Easy.</h2>
    <p class="lead">
      Leverage agile frameworks to provide a robust synopsis for high level
      overviews. Iterative approaches to corporate strategy foster
      collaborative.
    </p>

    <div class="contact-list">
      <div class="contact-item">
        <div class="icon-wrap">
          <PhoneIcon />
        </div>
        <div>
          <div class="label">Call Today</div>
          <a href="tel:+1800100900">+1 800 100 900</a>
        </div>
      </div>

      <div class="contact-item">
        <div class="icon-wrap green">
          <ClockIcon />
        </div>
        <div>
          <div class="label">Monday To Friday</div>
          <div class="value">9AM – 5PM</div>
        </div>
      </div>

      <div class="contact-item">
        <div class="icon-wrap">
          <PinIcon />
        </div>
        <div>
          <div class="label">USA Office</div>
          <div class="value">195 Devonshire St Boston, MA 02110</div>
        </div>
      </div>
    </div>
  </div>

  <div class="contact-gallery">
    <div class="large-card">
      <Image src={contactMain} alt="Consultant meeting" />
    </div>

    <div class="small-card small-top">
      <Image src={contactLaptop} alt="Consultant working" />
    </div>

    <div class="small-card small-bottom">
      <Image src={contactMeeting} alt="Team discussion" />
    </div>
  </div>
</section>

<style></style>
