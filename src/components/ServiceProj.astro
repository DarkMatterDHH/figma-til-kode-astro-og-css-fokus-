---
import financialProjections from "@data/financialProjections.json";
import Left from "@icons/arrow-left.svg";
import Right from "@icons/arrow--right.svg";
---

<section class="contains" aria-labelledby="projections-title">
  <div class="contents">
    <h3>{financialProjections.eyebrow}</h3>
    <h2 id="projections-title">{financialProjections.title}</h2>
    <p>{financialProjections.subtitle}</p>
  </div>

  <div class="buttons" aria-label="Scroll gennem finansielle værktøjer">
    <button
      class="carousel-button"
      type="button"
      data-scroll="-1"
      aria-label="Vis forrige kort"
    >
      <Left />
    </button>
    <button
      class="carousel-button"
      type="button"
      data-scroll="1"
      aria-label="Vis næste kort"
    >
      <Right />
    </button>
  </div>

  <div class="scroll-container" aria-label="Finansielle værktøjer">
    {
      financialProjections.values.map((item) => (
        <article class="item">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <a href={item.link.url}>{item.link.text}</a>
        </article>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".contains").forEach((section) => {
    const track = section.querySelector<HTMLElement>(".scroll-container");
    if (!track) return;

    section
      .querySelectorAll<HTMLButtonElement>("[data-scroll]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          const card = track.querySelector<HTMLElement>(".item");
          if (!card) return;

          const styles = getComputedStyle(track);
          const gap = parseFloat(styles.columnGap) || 0;
          const direction = Number(button.dataset.scroll) || 1;

          track.scrollBy({
            left: direction * (card.getBoundingClientRect().width + gap),
            behavior: "smooth",
          });
        });
      });
  });
</script>

<style>
  @layer components {
    .contains {
      grid-column: full-start / full-end;
      display: grid;
      grid-template-columns: subgrid;
      grid-template-rows: auto auto;
      row-gap: var(--space-8);
      padding-block: var(--space-16);
      min-width: 0;
      overflow: hidden;
      background: var(--color-surface-secondary);
    }

    .contents {
      grid-column: content-start / center;
      grid-row: 1;
      min-width: 0;
    }

    .contents h3 {
      margin: 0 0 var(--space-4);
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .contents h2 {
      margin: 0 0 var(--space-3);
      color: var(--color-text);
      font-size: var(--font-size-3xl);
      line-height: var(--line-height-heading);
    }

    .contents p {
      max-width: 58ch;
      margin: 0;
      color: var(--color-text-muted);
      line-height: var(--line-height-relaxed);
    }

    .buttons {
      grid-column: center / content-end;
      grid-row: 1;
      display: flex;
      align-items: end;
      justify-self: end;
      gap: var(--space-4);
    }

    .carousel-button {
      display: grid;
      width: 4rem;
      aspect-ratio: 1;
      place-items: center;
      padding: 0;
      border: 0;
      border-radius: var(--radius-pill);
      background: var(--color-neutrals-900);
      color: var(--color-neutrals-50);
      cursor: pointer;
    }

    .carousel-button :global(svg) {
      width: 1.5rem;
      height: 1.5rem;
    }

    .carousel-button:focus-visible {
      outline: 3px solid var(--color-action);
      outline-offset: 3px;
    }

    .scroll-container {
      grid-column: full-start / full-end;
      grid-row: 2;
      display: flex;
      gap: var(--space-8);
      min-width: 0;

      /* Matcher venstrekanten af content-start i global.css */
      padding-inline-start: max(1rem, calc((100vw - 75rem) / 2 + 1rem));
      padding-inline-end: 1rem;

      overflow-x: auto;
      overflow-y: hidden;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: max(1rem, calc((100vw - 75rem) / 2 + 1rem)) 1rem;
      scrollbar-width: thin;
      overscroll-behavior-inline: contain;
    }

    .item {
      box-sizing: border-box;
      display: flex;
      flex: 0 0 min(19.875rem, calc(100vw - 3rem));
      flex-direction: column;
      min-height: 15rem;
      padding: var(--space-8);
      border-radius: var(--radius-xl);
      background: var(--color-surface-tertiary);
      color: var(--color-text);
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    .item h3 {
      margin: 0 0 var(--space-3);
      font-size: var(--font-size-xl);
      line-height: var(--line-height-heading);
    }

    .item p {
      margin: 0;
      color: var(--color-text-muted);
      line-height: var(--line-height-relaxed);
    }

    .item a {
      margin-top: auto;
      padding-top: var(--space-4);
      color: var(--color-text);
      font-weight: var(--font-weight-semibold);
    }
  }
</style>
