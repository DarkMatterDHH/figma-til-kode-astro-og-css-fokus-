---
import Button from "./Button.astro";
import Left from "@icons/arrow-left.svg";
import Right from "@icons/arrow--right.svg";
---

<section class="contains">
  <section class="contents">
    <h3>Financial tools</h3>
    <h2>Financial Projections</h2>
    <p>
      Financial projections are essential for planing and monitoring a company's
      performance. They provide insight into potential revenue, expenses, and
      profitability over speciic periods.
    </p>
  </section>
  <section class="buttons">
    <Button><Left /></Button>
    <Button><Right /></Button>
  </section>
  <div class="scroll-container">
    <div class="item"><span>Item 1</span></div>
    <div class="item"><span>Item 2</span></div>
    <div class="item"><span>Item 3</span></div>
    <div class="item"><span>Item 4</span></div>
  </div>
</section>

<style>
  .scroll-container {
    padding-inline: 2rem;
    scroll-padding-inline: 2rem;
    overflow-inline: auto;
    display: flex;
    scroll-snap-type: inline mandatory;
  }
  .item {
    flex: 0 0 300px;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
</style>
