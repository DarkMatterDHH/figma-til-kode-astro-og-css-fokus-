---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
import Button from "./Button.astro";
---

<section class="hero">
  <div class="hero-content">
    <h1>Empowering Your Business Growth</h1>
    <p>
      Discover tailored strategies and expert insights to take your business to
      the next level. Let us help you navigate challenges and achieve
      sustainable success.
    </p>

    <section class="hero-button">
      <Button href="#0">Book a Meeting</Button>
    </section>

    <section class="hero-button" data-type="white">
      <Button href="#0">Learn More</Button>
    </section>
  </div>

  <Image class="hero-image" src={CEOImage} alt="CEO" />

  <div class="services">
    <Services />
  </div>
</section>

<style>
  @layer components {
    .hero {
      position: relative;
      display: grid;
      grid-column: full-start / full-end;
      grid-template-columns: subgrid;
      min-width: 0;
      min-height: 34rem;
      margin-bottom: 3rem;
      padding: 0;
      background-color: var(--color-neutrals-900);
      color: var(--color-on-surface-elevated);
    }

    .hero-content {
      grid-column: content-start / center;
      grid-row: 1;
      align-self: center;
      z-index: 1;
      min-width: 0;
      padding: var(--space-12) var(--space-8);
    }

    .hero-image {
      grid-column: center / full-end;
      grid-row: 1;
      display: block;
      width: 100%;
      height: 100%;
      min-width: 0;
      min-height: 34rem;
      object-fit: cover;
    }
    .hero-content h1 {
      max-width: 14ch;
      margin: 0 0 var(--space-4);
      color: var(--color-on-surface-elevated);
      font-size: var(--font-size-3xl);
      line-height: var(--line-height-tight);
    }

    .hero-content p {
      max-width: 48ch;
      color: var(--color-on-ui-primary-muted);
      line-height: var(--line-height-relaxed);
    }

    .services {
      position: absolute;
      z-index: 2;
      right: 0;
      bottom: -3.5rem;
      left: 0;
      width: min(63rem, calc(100% - 3rem));
      margin-inline: auto;
    }
  }
</style>
