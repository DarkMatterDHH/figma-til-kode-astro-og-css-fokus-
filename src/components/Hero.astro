---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
import Button from "./Button.astro";
---

<section class="hero">
  <div class="hero-content">
    <h1>Empowering Your Business Growth</h1>
    <p>
      Discover tailored strategies and expert insights to take your business to
      the next level. Let us help you navigate challenges and achieve
      sustainable success.
    </p>
    <section>
      <Button href="#0">Book a Meeting</Button>
    </section>
    <section data-type="white">
      <Button href="#0">Learn More</Button>
    </section>
  </div>
  <Image src={CEOImage} alt="CEO" />

  <Services />
</section>

<style>
  /* Styles her */
  @layer components {
    .hero {
      background-color: #f3f4f6;
      padding: 2rem;
    }

    .hero {
      display: grid;
      grid-template-areas:
        "content image"
        "Services Services";
    }
    .hero-content {
      grid-area: content;
      align-self: center;
    }
    .image {
      grid-area: "image";
      min-height: 32rem;
    }

    .image :global(img) {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
