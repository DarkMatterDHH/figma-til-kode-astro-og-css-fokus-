---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
import Button from "./Button.astro";
---

<section class="hero">
  <div class="hero-content">
    <h1>Empowering Your Business Growth</h1>
    <p>
      Discover tailored strategies and expert insights to take your business to
      the next level. Let us help you navigate challenges and achieve
      sustainable success.
    </p>

    <section class="hero-button">
      <Button href="#0">Book a Meeting</Button>
    </section>

    <section class="hero-button" data-type="white">
      <Button href="#0">Learn More</Button>
    </section>
  </div>

  <Image class="hero-image" src={CEOImage} alt="CEO" />

  <div class="services">
    <Services />
  </div>
</section>

<style>
  @layer components {
    .hero {
      --hero-bg: var(--color-background, #050812);
      --hero-text: var(--color-text-inverse, #f7f8fc);
      --hero-muted: var(--color-text-muted, #a3aab8);
      --hero-accent: var(--color-accent, #ffca3a);
      --hero-border: var(--color-border, #737985);

      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: 33.5rem;
      margin-bottom: 3rem;
      padding: 0;
      background-color: var(--hero-bg);
    }

    .hero-content {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
      padding: 3rem clamp(2rem, 7.5vw, 8rem);
      color: var(--hero-text);
    }

    .hero-content h1 {
      max-width: 22ch;
      margin: 0 0 1rem;
      font-size: clamp(2rem, 3vw, 3rem);
      line-height: 1.08;
      color: var(--hero-text);
    }

    .hero-content p {
      color: var(--color-text-inverse, #a3aab8);
      line-height: 1.6;
    }

    .hero-button {
      --button-bg: var(--hero-accent);
      --button-text: var(--hero-bg);
      --button-border: var(--hero-accent);
      display: inline-block;
      margin: 1rem 0.5rem 0 0;
    }

    .hero-button[data-type="white"] {
      --button-bg: transparent;
      --button-text: var(--hero-text);
      --button-border: var(--hero-border);
    }

    .hero-image {
      grid-column: 2;
      grid-row: 1;
      display: block;
      width: 100%;
      height: 100%;
      min-height: 34rem;
      object-fit: cover;
    }

    .services {
      position: absolute;
      z-index: 1;
      right: 0;
      bottom: -3.5rem;
      left: 0;
      width: min(63rem, calc(100% - 3rem));
      margin-inline: auto;
    }
  }
</style>
