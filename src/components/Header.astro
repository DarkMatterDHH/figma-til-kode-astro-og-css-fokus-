---
import Button from "./Button.astro";

const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);

// Links, der vises i navigationen.
// Sæt active til true på den aktuelle side.
const navItems = [
  { label: "Home", href: "/" },
  { label: "Case Studies", href: "/case-studies" },
  { label: "Team", href: "/team" },
  { label: "About", href: "/about" },
].map((item) => ({
  ...item,
  active: currentPath === normalizePath(item.href),
}));
---

<!-- Sidens hovednavigation med logo, links og login-knap. -->
<header class="site-header" data-type="dark">
  <div class="header-inner">
    <!-- Logoet linker tilbage til forsiden. -->
    <a class="logo" href="/" aria-label="AskExperts – forsiden">
      Ask<span>Experts</span>
    </a>

    <!-- Navigationens links oprettes ud fra navItems-listen. -->
    <nav aria-label="Hovednavigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", item.active && "active"]}
            aria-current={item.active ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Link til login-siden. -->
    <div class="login anchor">
      <Button popovertarget="popup">Login</Button>
    </div>
  </div>
</header>
<div id="popup" popover="auto" class="target">
  <h2>Dashboard Login</h2>
  <p>Email address</p>
  <input type="email" />
  <p>Password</p>
  <input type="password" />
  <Button>Go to dashboard</Button>
</div>
<style>
  .anchor {
    anchor-name: --anchor;
  }

  .target {
    position: absolute;
    position-anchor: --anchor;
    position-area: bottom;

    box-sizing: border-box;
    width: min(24.5rem, calc(100vw - 2rem));
    padding: 2rem;
    border: 0;
    border-radius: var(--radius-xl);
    background: var(--color-neutrals-50);
    color: var(--color-neutrals-900);
    box-shadow: 0 1rem 2.5rem rgb(3 7 18 / 25%);
  }

  .target:popover-open {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .target h2 {
    font-size: 2.5rem;
    line-height: var(--line-height-heading);
  }

  .target p {
    margin: 0;
    font-size: var(--font-size-md);
  }

  .target input {
    box-sizing: border-box;
    width: 100%;
    min-height: 3.6rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-neutrals-400);
    border-radius: var(--radius-pill);
    background: var(--color-surface-primary);
    color: var(--color-text);
  }

  .target :global(.button) {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: var(--space-3);
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-action);
    color: var(--color-neutrals-900);
  }

  .site-header {
    grid-column: full-start / full-end;
    background: var(--color-neutrals-900);
    color: var(--color-on-surface-elevated);
    padding: var(--space-4) var(--space-6);
  }

  .header-inner {
    position: relative;
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(100%, 1200px);
    min-width: 0;
    margin-inline: auto;
  }

  .logo {
    color: var(--color-on-surface-elevated);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    white-space: nowrap;
  }

  .logo span {
    color: var(--color-action);
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-link {
    position: relative;
    color: var(--color-on-surface-elevated);
    font-size: var(--font-size-sm);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-link.active::after {
    position: absolute;
    right: 0;
    bottom: -0.6rem;
    left: 0;
    height: 3px;
    background: var(--color-action);
    content: "";
  }

  .header-inner > .login {
    justify-self: end;
  }
</style>
