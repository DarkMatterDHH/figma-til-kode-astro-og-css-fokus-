---
import Button from "./Button.astro";

const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);

// Links, der vises i navigationen.
// Sæt active til true på den aktuelle side.
const navItems = [
  { label: "Home", href: "/" },
  { label: "Case Studies", href: "/case-studies" },
  { label: "Team", href: "/team" },
  { label: "About", href: "/about" },
].map((item) => ({
  ...item,
  active: currentPath === normalizePath(item.href),
}));
---

<!-- Sidens hovednavigation med logo, links og login-knap. -->
<header class="site-header" data-type="dark">
  <div class="header-inner">
    <!-- Logoet linker tilbage til forsiden. -->
    <a class="logo" href="/" aria-label="AskExperts – forsiden">
      Ask<span>Experts</span>
    </a>

    <!-- Navigationens links oprettes ud fra navItems-listen. -->
    <nav aria-label="Hovednavigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", item.active && "active"]}
            aria-current={item.active ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Link til login-siden. -->
    <div class="login">
      <Button href="/login">Login</Button>
    </div>
  </div>
</header>

<style>
  /* Baggrund og grundfarve for hele headeren. */
  .site-header {
    background: #030815;
    color: #f5f6f8;
    padding: 2.25rem 1.5rem;
  }

  /* Placerer logo, navigation og login i tre kolonner. */
  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Logoets tekststil og farver. */
  .logo {
    color: #f5f6f8;
    font-size: 1.75rem;
    font-weight: 600;
    text-decoration: none;
  }

  /* Giver anden del af logoet den gule accentfarve. */
  .logo span {
    color: #ffd447;
  }

  /* Viser navigationslinks på én række med mellemrum. */
  nav {
    display: flex;
    gap: 2rem;
  }

  /* Grundstil for navigationslinks. */
  .nav-link {
    position: relative;
    color: #e5e7eb;
    font-size: 1.125rem;
    text-decoration: none;
  }

  /* Gul markering under det aktive navigationslink. */
  .nav-link.active::after {
    position: absolute;
    right: 0;
    bottom: -0.5rem;
    left: 0;
    height: 4px;
    background: #ffd447;
    content: "";
  }

  /* Login-linket styles, så det ligner en lys, rund knap. */
  .header-inner > .login {
    justify-self: end;
  }

  /* Tilpas layoutet til mindre skærme. */
  @media (max-width: 700px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      gap: 1.5rem;
    }

    /* Flyt navigationen ned under logo og login, og tillad linjeskift. */
    nav {
      grid-column: 1 / -1;
      grid-row: 2;
      flex-wrap: wrap;
      gap: 1.5rem;
    }
  }
</style>
