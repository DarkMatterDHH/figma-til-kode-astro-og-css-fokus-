---
import News from "@components/Newsletter.astro";
---

<footer class="site-footer">
  <News />

  <div class="footer-bar">
    <div class="brand">
      Ask<span>Experts</span>
    </div>

    <p class="copyright">©2026 Consultalk. All rights reserved</p>

    <nav class="footer-links">
      <a href="#">Terms of Service</a>
      <span>|</span>
      <a href="#">Privacy Policy</a>
    </nav>
  </div>
</footer>

<style>
  @layer components {
    .site-footer {
      grid-column: full-start / full-end;
      display: grid;
      grid-template-columns: subgrid;
      background: var(--color-neutrals-900);
      color: var(--color-neutrals-50);
      padding-top: var(--space-12);
      min-width: 0;
    }

    .site-footer > :global(.newsletter) {
      grid-column: full-start / full-end;
      display: grid;
      grid-template-columns: subgrid;
      min-width: 0;
    }

    .footer-bar {
      grid-column: content-start / content-end;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: var(--space-6);
      padding-block: var(--space-8) var(--space-6);
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    .brand {
      justify-self: start;
      color: var(--color-neutrals-50);
      font-size: clamp(1.5rem, 2vw, 2.25rem);
      font-weight: var(--font-weight-semibold);
      letter-spacing: -0.04em;
    }

    .brand span {
      color: var(--color-action);
    }

    .copyright {
      justify-self: center;
      margin: 0;
      color: var(--color-neutrals-200);
      font-size: var(--font-size-sm);
    }

    .footer-links {
      justify-self: end;
      display: flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-neutrals-200);
      font-size: var(--font-size-sm);
    }

    .footer-links a {
      color: inherit;
      text-decoration: none;
    }
  }
</style>
