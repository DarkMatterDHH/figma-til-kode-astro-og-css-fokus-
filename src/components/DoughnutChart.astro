---
interface Props {
  value: number;
  label: string;
}

const { value, label } = Astro.props;
const percentage = Math.min(100, Math.max(0, Number(value) || 0));

const radius = 52;
const circumference = 2 * Math.PI * radius;
const dashLength = (percentage / 100) * circumference;
const angle = ((percentage * 3.6 - 90) * Math.PI) / 180;
const markerX = 60 + radius * Math.cos(angle);
const markerY = 60 + radius * Math.sin(angle);
---

<article class="stat">
  <div class="chart">
    <svg
      viewBox="0 0 120 120"
      role="img"
      aria-label={`${label}: ${percentage}%`}
    >
      <circle class="track" cx="60" cy="60" r={radius}></circle>
      <circle
        class="progress"
        cx="60"
        cy="60"
        r={radius}
        stroke-dasharray={`${dashLength} ${circumference}`}></circle>
      <circle class="marker" cx={markerX} cy={markerY} r="7"></circle>
    </svg>

    <span class="value">{percentage}%</span>
  </div>

  <h3>{label}</h3>
</article>

<style>
  .stat {
    min-width: 0;
    text-align: center;
  }

  .chart {
    position: relative;
    width: clamp(8rem, 12vw, 12rem);
    aspect-ratio: 1;
    margin-inline: auto;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .track,
  .progress {
    fill: none;
    stroke-width: 3;
  }

  .track {
    stroke: rgb(3 7 18 / 18%);
  }

  .progress {
    stroke: var(--color-neutrals-50);
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-origin: 60px 60px;
  }

  .marker {
    fill: var(--color-neutrals-900);
    stroke: var(--color-neutrals-50);
    stroke-width: 3;
  }

  .value {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-neutrals-900);
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: var(--font-weight-bold);
  }

  h3 {
    margin: var(--space-4) 0 0;
    color: var(--color-neutrals-900);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
  }
</style>
